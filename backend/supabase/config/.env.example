# ============================================================
# Trombl — Environment Variables Template
# ============================================================
# Copy to .env.local and fill in your values.
# NEVER commit .env.local to version control.
#
# Security tiers:
#   [CLIENT-SAFE]  — safe to include in Flutter app at build time
#   [SERVER-ONLY]  — Edge Functions / service role only, never in Flutter
#   [CRON-ONLY]    — used exclusively by the trombl-cleanup cron job
# ============================================================

# ─── Supabase Project ────────────────────────────────────────────────────────

# [CLIENT-SAFE] Your Supabase project reference ID
SUPABASE_PROJECT_ID=your_project_id

# [CLIENT-SAFE] REST/Realtime API base URL
SUPABASE_URL=https://your_project_id.supabase.co

# [CLIENT-SAFE] Anonymous (public) key — used by Flutter SDK and user-facing RLS
SUPABASE_ANON_KEY=your_anon_key

# [SERVER-ONLY] Service role key — bypasses RLS, used only in Edge Functions
# Never expose this to the Flutter client or include it in app bundles.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# [SERVER-ONLY] Direct PostgreSQL connection string — used by Supabase CLI and tests
# Format: postgresql://postgres:<password>@db.<project_id>.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your_password@db.your_project_id.supabase.co:5432/postgres

# [SERVER-ONLY] JWT signing secret — used to verify auth tokens server-side
SUPABASE_JWT_SECRET=your_jwt_secret

# ─── Cron Job Security ───────────────────────────────────────────────────────

# [CRON-ONLY] Shared secret that authorizes the trombl-cleanup cron job.
# Generate with: openssl rand -hex 32
# Set in Supabase via: supabase secrets set CRON_SECRET=<value>
CRON_SECRET=your_cron_secret_32_hex_chars

# ─── Push Notifications (Firebase Cloud Messaging) ───────────────────────────
# Uses FCM v1 API authenticated via a Google service account.
# Obtain from: Firebase Console → Project Settings → Service Accounts →
#              "Generate new private key" → download JSON.
#
# Paste the ENTIRE JSON file content as a single line (or use jq):
#   jq -c . path/to/serviceAccount.json
#
# Set in Supabase Edge Function secrets (never commit the real value):
#   supabase secrets set FCM_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'

# [SERVER-ONLY] Full Firebase service account JSON (minified to one line)
FCM_SERVICE_ACCOUNT_JSON=

# ─── Optional Integrations ───────────────────────────────────────────────────

# [SERVER-ONLY] AI content moderation API key (e.g. OpenAI Moderation endpoint)
# Leave blank to disable automated content moderation.
MODERATION_API_KEY=

# [SERVER-ONLY] Geo IP API key for server-side city detection
# Leave blank to rely on client-submitted city values.
GEO_IP_API_KEY=

# ─── App Runtime ─────────────────────────────────────────────────────────────

# [SERVER-ONLY] Deployment environment. Affects logging verbosity.
# Values: development | staging | production
APP_ENV=development

# [CLIENT-SAFE] App display name
APP_NAME=Trombl

# ─── Drift Business Logic ────────────────────────────────────────────────────
# These tune behaviour without code changes. All have safe defaults in env.ts.
# [SERVER-ONLY] — only Edge Functions read these.

# Default discovery radius in km (used when client omits radius_km)
DRIFT_DEFAULT_RADIUS_KM=2

# Hard cap on radius_km accepted from clients
DRIFT_MAX_RADIUS_KM=10

# How long a drift session stays active (hours)
DRIFT_SESSION_DURATION_HOURS=2

# Minutes the contact reveal window stays open after mutual consent
DRIFT_CONTACT_EXCHANGE_WINDOW_MINUTES=5

# Minutes before a location record expires from drift_user_locations
DRIFT_LOCATION_TTL_MINUTES=15

# Trust score floor below which a user cannot send match requests
DRIFT_MIN_TRUST_SCORE_TO_MATCH=20

# Max simultaneous pending outgoing match requests per user
DRIFT_MAX_PENDING_MATCHES=5

# Max stories a user can publish per hour
DRIFT_MAX_STORIES_PER_HOUR=5
